# Supabase Edge Function secret to add when ready (never add a VITE_ prefix):
# FLUTTERWAVE_SECRET_KEY=replace-with-your-flutterwave-sandbox-secret-key
# FLUTTERWAVE_WEBHOOK_SECRET_HASH=replace-with-your-dashboard-webhook-secret-hash
